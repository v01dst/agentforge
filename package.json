{
  "name": "agentforge",
  "version": "0.0.1",
  "private": true,
  "description": "Model-agnostic AI agent runtime and visual workflow platform.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
