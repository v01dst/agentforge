{
  "name": "@agentforge-oss/mcp",
  "version": "0.4.0",
  "description": "Model Context Protocol client adapters for AgentForge agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
