{
  "name": "@agentforge-oss/cli",
  "version": "0.4.0",
  "description": "Developer CLI for AgentForge projects",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentforge": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@agentforge-oss/mcp": "workspace:*",
    "@agentforge-oss/tools": "workspace:*",
    "@agentforge-oss/workflows": "workspace:*",
    "zod": "^3.24.1",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "@agentforge-oss/models": "workspace:*",
    "@agentforge-oss/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v01dst/agentforge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/v01dst/agentforge#readme",
  "bugs": {
    "url": "https://github.com/v01dst/agentforge/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "v01dst"
}
